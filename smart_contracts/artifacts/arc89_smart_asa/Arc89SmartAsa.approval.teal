    // smart_contracts/arc89_smart_asa/contract.py:122
    // reserve == Global.zero_address
    global ZeroAddress
    ==
    // smart_contracts/arc89_smart_asa/contract.py:122-123
    // reserve == Global.zero_address
    // or reserve == Global.current_application_address
    bnz _circulating_supply_if_body@2
    // smart_contracts/arc89_smart_asa/contract.py:123
    // or reserve == Global.current_application_address
    dup
    global CurrentApplicationAddress
    ==
    // smart_contracts/arc89_smart_asa/contract.py:122-123
    // reserve == Global.zero_address
    // or reserve == Global.current_application_address
    bz _circulating_supply_after_if_else@3

_circulating_supply_if_body@2:
    pop
    // smart_contracts/arc89_smart_asa/contract.py:125
    // return issued
    retsub

