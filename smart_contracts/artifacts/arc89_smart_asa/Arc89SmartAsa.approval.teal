    // def _circulating_supply(self, ctrl_asset: Asset) -> UInt64:
    proto 1 1
    // smart_contracts/arc89_smart_asa/contract.py:117-119
    // # ARC-62 refinement: units held by the Reserve (e.g., a treasury) are issued,
    // # but not circulating
    // issued = self._issued_supply(ctrl_asset)
    frame_dig -1
    callsub _issued_supply
    // smart_contracts/arc89_smart_asa/contract.py:120
