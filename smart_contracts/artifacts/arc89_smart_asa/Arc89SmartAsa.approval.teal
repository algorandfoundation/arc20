    frame_dig -1
    asset_holding_get AssetBalance
    pop
    // smart_contracts/arc89_smart_asa/contract.py:129
    // return issued - reserve_balance
    -
    retsub


// smart_contracts.smart_asa.contract.SmartAsa._issued_supply(ctrl_asset: uint64) -> uint64:
_issued_supply:
    // smart_contracts/smart_asa/contract.py:78
    // def _issued_supply(self, ctrl_asset: Asset) -> UInt64:
    proto 1 1
    // smart_contracts/smart_asa/contract.py:79-80
    // # The App holds the units not issued yet: the total caps the issued ones
    // return cfg.TOTAL - ctrl_asset.balance(Global.current_application_address)
    global CurrentApplicationAddress
    frame_dig -1
    asset_holding_get AssetBalance
    assert // account opted into asset
    intc 5 // 18446744073709551615
    swap
    -
    retsub


// smart_contracts.smart_asa.contract.SmartAsa._assert_common_preconditions(asset: uint64) -> void:
_assert_common_preconditions:
    // smart_contracts/smart_asa/contract.py:89
    // def _assert_common_preconditions(self, asset: Asset) -> None:
    proto 1 0
    // smart_contracts/smart_asa/contract.py:90
    // logged_assert(self.smart_asa_id != 0, err.MISSING_CTRL_ASA)
    intc_0 // 0
    bytec 4 // "smart_asa_id"
    app_global_get_ex
    assert // check self.smart_asa_id exists
    bnz _assert_common_preconditions_after_assert@2
    pushbytes "ERR:ctrlAsaNotExist"
    log
    err // ERR:ctrlAsaNotExist

_assert_common_preconditions_after_assert@2:
    // smart_contracts/smart_asa/contract.py:91
    // logged_assert(self.smart_asa_id == asset.id, err.INVALID_CTRL_ASA)
    intc_0 // 0
    bytec 4 // "smart_asa_id"
    app_global_get_ex
    assert // check self.smart_asa_id exists
    frame_dig -1
    ==
    bnz _assert_common_preconditions_after_assert@4
    pushbytes "ERR:ctrlAsaInvalid"
    log
    err // ERR:ctrlAsaInvalid

_assert_common_preconditions_after_assert@4:
    retsub


// smart_contracts.smart_asa.contract.SmartAsa._is_frozen(account: bytes) -> uint64:
_is_frozen:
    // smart_contracts/smart_asa/contract.py:93
    // def _is_frozen(self, account: Account) -> bool:
    proto 1 1
    // smart_contracts/smart_asa/contract.py:94-95
    // # A box flips the default freeze state of its account
    // return self.default_frozen != (account in self.freeze_exceptions)
    intc_0 // 0
    bytec 8 // "default_frozen"
    app_global_get_ex
    assert // check self.default_frozen exists
    bytec 16 // 0x66
    frame_dig -1
    concat
    box_len
    bury 1
    !=
    retsub


// smart_contracts.smart_asa.contract.SmartAsa._assert_reserve_not_frozen() -> void:
_assert_reserve_not_frozen:
    // smart_contracts/smart_asa/contract.py:134-135
    // # The Reserve obeys account freezes, even if it is also the Clawback
    // logged_assert(not self._is_frozen(self.reserve_addr), err.RESERVE_FROZEN)
    intc_0 // 0
    bytec_0 // "reserve_addr"
    app_global_get_ex
    assert // check self.reserve_addr exists
    callsub _is_frozen
    bz _assert_reserve_not_frozen_after_assert@2
    pushbytes "ERR:reserveFrozen"
    log
    err // ERR:reserveFrozen

_assert_reserve_not_frozen_after_assert@2:
    retsub


// smart_contracts.smart_asa.contract.SmartAsa._assert_valid_metadata_hash(metadata_hash: bytes) -> void:
_assert_valid_metadata_hash:
    // smart_contracts/smart_asa/contract.py:153
    // def _assert_valid_metadata_hash(self, metadata_hash: Bytes) -> None:
    proto 1 0
    // smart_contracts/smart_asa/contract.py:156
    // metadata_hash.length == cfg.METADATA_HASH_LENGTH,
    frame_dig -1
    len
    intc_2 // 32
    ==
    // smart_contracts/smart_asa/contract.py:154-158
    // # Non-normative: stricter than ARC-20, which allows any `byte[]` length
    // logged_assert(
    //     metadata_hash.length == cfg.METADATA_HASH_LENGTH,
    //     err.INVALID_METADATA_HASH_LENGTH,
    // )
    bnz _assert_valid_metadata_hash_after_assert@2
    pushbytes "ERR:metadataHashInvalid"
    log
    err // ERR:metadataHashInvalid

_assert_valid_metadata_hash_after_assert@2:
    retsub
